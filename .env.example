# Copy to .env (untracked) and fill in. Never commit real values.
# Postgres connection string. In deployed environments this comes from the secrets manager.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# pg (TCP 5432, default) or neon-ws (Neon over WebSocket on 443, for HTTPS-only networks)
DB_DRIVER=pg
# development | test | ci | staging | production
APP_ENV=development
# API
PORT=4000
SESSION_SECRET=change-me-to-32-or-more-random-characters
# Development and staging only: sign in as a demo bidder (A42). Refused in production.
DEMO_SIGN_IN=1
# Worker
GATE_PASS_SECRET=change-me
WORKER_INTERVAL_MS=5000
# Web: where the Next.js server reaches the API
API_URL=http://localhost:4000
