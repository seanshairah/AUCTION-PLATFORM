# Copy to .env (untracked) and fill in. Never commit real values.
# Postgres connection string. In deployed environments this comes from the secrets manager.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# pg (TCP 5432, default) or neon-ws (Neon over WebSocket on 443, for HTTPS-only networks)
DB_DRIVER=pg
# development | test | ci | staging | production
APP_ENV=development
# API
PORT=4000
SESSION_SECRET=change-me-to-32-or-more-random-characters
# Development and staging only: sign in as a demo bidder (A42). Refused in production.
DEMO_SIGN_IN=1
# Worker
GATE_PASS_SECRET=change-me
WORKER_INTERVAL_MS=5000
# Web: where the Next.js server reaches the API
API_URL=http://localhost:4000
# Communications and one-time-code sign-in (docs/16). Required in production (32+ characters):
OTP_SECRET=change-me-to-32-or-more-random-characters
LINK_SIGNAL_SECRET=change-me-to-32-or-more-random-characters
# Links in messages
PUBLIC_WEB_URL=http://localhost:3000
# WhatsApp Cloud API (unverified adapter, A43). Without an access token, development uses a fake channel.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_INTAKE_BRANCH=HRE
# HTTP SMS aggregator (unverified adapter, A44)
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=ABCAuction
SMS_STATUS_SECRET=
# Email: no provider yet (A48). EMAIL_TRANSPORT=log logs emails instead (never in real production use).
EMAIL_FROM=ABC Auctions <no-reply@localhost>
