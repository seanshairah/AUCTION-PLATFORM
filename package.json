{
  "name": "abc-auctions",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "rulebook:sql": "pnpm --filter @abc/rules gen:sql",
    "db:status": "pnpm --filter @abc/db db status",
    "db:migrate": "pnpm --filter @abc/db db migrate",
    "db:rulebook": "pnpm --filter @abc/db db load-rulebook",
    "demo:seed": "pnpm --filter @abc/api demo:seed",
    "db:reset": "pnpm --filter @abc/db db reset"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "@types/pg": "^8.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
